{
  "name": "macos-security-framework",
  "version": "0.1.0",
  "description": "Complete JavaScript and TypeScript bindings for Rust security-framework on macOS",
  "keywords": [
    "macos",
    "security-framework",
    "keychain",
    "cryptography",
    "napi-rs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukashazia/macos-security-framework.git"
  },
  "homepage": "https://github.com/ukashazia/macos-security-framework#readme",
  "bugs": {
    "url": "https://github.com/ukashazia/macos-security-framework/issues"
  },
  "license": "MIT",
  "author": "Ukasha",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "macos_security_framework.darwin-arm64.node",
    "macos_security_framework.darwin-x64.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "napi build --release --platform --esm --target $(cargo -vV | sed -n 's/^host: //p')",
    "build:all": "napi build --release --platform --esm --target aarch64-apple-darwin && napi build --release --platform --esm --target x86_64-apple-darwin",
    "build:debug": "napi build --platform --esm --target $(cargo -vV | sed -n 's/^host: //p')",
    "check": "cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && tsc --noEmit",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && npm test",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "release:check": "npm run verify && npm run verify:artifacts && npm pack --dry-run --ignore-scripts",
    "prepack": "npm run verify:artifacts",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "napi": {
    "binaryName": "macos_security_framework",
    "packageName": "macos-security-framework",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  }
}
