{
  "name": "msf-ffi",
  "version": "0.1.0",
  "description": "Complete JavaScript and TypeScript bindings for Rust security-framework on macOS",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "napi build --release --platform --esm",
    "build:debug": "napi build --platform --esm",
    "check": "cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && tsc --noEmit",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "napi": {
    "binaryName": "msf_ffi"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "license": "MIT"
}
